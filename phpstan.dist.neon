# php8.5 vendor/bin/phpstan analyse --memory-limit=1G
# Die Stufe wird schrittweise angehoben und alles behoben, auch in altem Code – bewusst ohne Baseline.
includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    # Abgekündigte Funktionen und Klassen (PHP 8.5, Symfony, Doctrine) – fehlte bis 2026-11-03, deshalb fiel curl_close() nicht auf
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
parameters:
    level: 8
    # Gegen die Version prüfen, die produktiv läuft
    phpVersion: 80500
    doctrine:
        objectManagerLoader: tests/phpstan-object-manager.php
    paths:
        - src
        - tests
    excludePaths:
        - src/Kernel.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanDirectories:
        - migrations
