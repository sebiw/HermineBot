<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title }} - {{ ov }}{% endblock %}</title>
    <link rel="icon" href="/favicon.ico">
    {# Aussehen und Verhalten wie im StAN-Manager: gebaut dort mit bin/hermine-bot-assets, main.css nur für Bot-Eigenes #}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/stan/stan.css') }}?v={{ app_version }}">
        <link rel="stylesheet" href="{{ asset('assets/main.css') }}?v={{ app_version }}">
    {% endblock %}
    {# Meldungen nach Aktionen erscheinen oben rechts (appToast), wie im StAN-Manager #}
    <script type="application/javascript">
        var session = {{ {
            errorMessage: app.flashes('error')|join(' ') ?: null,
            warningMessage: app.flashes('warning')|join(' ') ?: null,
            statusMessage: app.flashes('success')|join(' ') ?: null
        }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
    </script>
    {% block javascripts %}
        <script type="application/javascript" src="{{ asset('assets/stan/stan.js') }}?v={{ app_version }}"></script>
    {% endblock %}
</head>
<body>
    {# Navigation einmal rendern: ohne Einträge (Login) gibt es weder Leiste noch Menü-Knopf #}
    {% set navigation %}{% block nav %}{% endblock %}{% endset %}
    {% set navigation = navigation|trim %}
    <header class="primary">
        {% if navigation is not empty %}
            <button type="button" class="nav-toggle no-print" aria-label="Menü" aria-controls="main-nav" aria-expanded="false">☰</button>
        {% endif %}
        <span class="header-title">{{ title }} - {{ ov }}</span>
        {% if is_granted('ROLE_USER') %}
            <a href="#" class="app-version no-print" title="Changelog anzeigen" data-changelog-url="{{ path('changelog') }}">v{{ app_version }}</a>
        {% else %}
            <span class="app-version no-print">v{{ app_version }}</span>
        {% endif %}
    </header>
    <div class="wrapper">

        <div class="topnav">
            {% block topnav %}{% endblock %}
        </div>

        {% if navigation is not empty %}
            <nav class="primary no-print" id="main-nav">
                {{ navigation|raw }}
            </nav>
        {% endif %}

        <main class="primary">
            {% block body %}{% endblock %}
        </main>

        <footer class="primary">
            {% block footer %}{% endblock %}
        </footer>

    </div>
</body>
</html>
