{% extends 'base.html.twig' %}

{% block title %}{{ title }} - {{ ov }} - Log in!{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {{ parent() }}
    <div class="text-center">
        <form method="post" action="{{ path('app_login') }}">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <h1 class="h3 font-weight-normal">Login</h1>
            <div class="spacer">
                <label for="username">Benutzername:</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control"
                       required autofocus>
            </div>
            <div class="spacer">
                <label for="password">Passwort:</label>
                <input type="password" name="_password" id="password" class="form-control" required>
            </div>
            <div class="spacer">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <input type="hidden" name="_target_path" value="{{ path('events') }}"/>

                <button class="button-primary" type="submit">
                    Sign in
                </button>
            </div>
        </form>
    </div>
{% endblock %}
