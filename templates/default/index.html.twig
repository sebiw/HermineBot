{% extends 'base.loggedin.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/assets/npm-asset/timepicker/jquery.timepicker.min.css">
{% endblock %}

{%  block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="/assets/npm-asset/jquery-ui/ui/i18n/datepicker-de.js"></script>
    <script type="application/javascript" src="/assets/npm-asset/timepicker/jquery.timepicker.min.js"></script>
    <script type="text/javascript">
        $( function() {

            let conversation_channel_placeholder_name = '{{ conversation_channel_placeholder_name }}';

            $( ".thw-datepicker" ).datepicker(
                $.datepicker.regional[ "de" ]
            );
            $('.thw-timepicker').timepicker({
                timeFormat: '{{ time_format }}',
                step: 30,
                minTime: '00:00',
                maxTime: '23:30',
                // forceRoundTime: true,
                startTime: '10:00',
                orientation: 'l',
                className: 'thw-timepicker-list'
            });

            $('#action .action-button').click(function( event ){
                $('#actionButtonId').val( $(this).data('id') );
            });

            $('#interval').change(function(){
                let self = $(this);
                if( self.val() == "" ){
                    $('#untilDate').val("").prop( "disabled", true );
                    $('#untilTime').val("").prop( "disabled", true );
                } else {
                    $('#untilDate').prop( "disabled", false );
                    $('#untilTime').prop( "disabled", false );
                }
            }).change();

            // Unterhaltungen: Die Auswahl füllt nur das ID-Feld, das ID-Feld selbst wird gespeichert.
            // So bleibt eine gespeicherte ID erhalten, auch wenn die Unterhaltung nicht (mehr) in der Liste steht.
            let conversations = null;
            let conversationsState = 'idle';
            let conversationsError = '';
            let conversationId = $('.conversation-id');
            let conversationToggle = $('.conversation-toggle');
            let conversationPanel = $('.conversation-panel');
            let conversationFilter = $('.conversation-filter');
            let conversationList = $('.conversation-list');
            let conversationInfo = $('.conversation-info');

            function findConversation( id ){
                return ( conversations || [] ).find(function( conversation ){ return conversation.id === id; });
            }

            function updateConversationInfo(){
                let id = $.trim( conversationId.val() );
                if( conversationId.prop('disabled') ){
                    conversationInfo.text('');
                } else if( conversationsState === 'error' ){
                    conversationInfo.text('Unterhaltungen konnten nicht geladen werden – ID von Hand eintragen. Fehler: ' + conversationsError );
                } else if( conversations === null ){
                    conversationInfo.text('Lade Unterhaltungen …');
                } else if( id === '' ){
                    conversationInfo.text('');
                } else {
                    let found = findConversation( id );
                    conversationInfo.text( found ? found.label : 'Unterhaltung nicht in der Liste der offenen Unterhaltungen (archiviert?) – die ID bleibt erhalten.' );
                }
            }

            function renderConversationList(){
                let terms = conversationFilter.val().toLowerCase().split(/\s+/).filter(function( term ){ return term !== ''; });
                let current = $.trim( conversationId.val() );
                conversationList.empty();
                if( conversationsState === 'error' ){
                    $('<li class="conversation-hint">').text('Fehler: ' + conversationsError ).appendTo( conversationList );
                    return;
                }
                if( conversations === null ){
                    $('<li class="conversation-hint">').text('Lade Unterhaltungen …').appendTo( conversationList );
                    return;
                }
                let matches = conversations.filter(function( conversation ){
                    let label = conversation.label.toLowerCase();
                    return terms.every(function( term ){ return label.indexOf( term ) !== -1; });
                });
                if( matches.length === 0 ){
                    $('<li class="conversation-hint">').text('Keine passende Unterhaltung.').appendTo( conversationList );
                }
                $.each( matches , function( index , conversation ){
                    $('<li class="conversation-option">')
                        .toggleClass('selected' , conversation.id === current )
                        .attr('data-id' , conversation.id )
                        .text( conversation.label )
                        .appendTo( conversationList );
                });
            }

            function openConversationPanel(){
                conversationPanel.prop('hidden' , false );
                // Am Fenster ausrichten (position: fixed), sonst schneidet der scrollbare Tabellen-Container das Menü ab
                let rect = conversationToggle[0].getBoundingClientRect();
                conversationPanel.css({
                    top: rect.bottom,
                    left: Math.max( 8 , Math.min( rect.left , window.innerWidth - conversationPanel.outerWidth() - 8 ) )
                });
                conversationFilter.val('');
                renderConversationList();
                conversationFilter.trigger('focus');
            }

            function closeConversationPanel(){
                conversationPanel.prop('hidden' , true );
            }

            function loadConversations(){
                if( conversationsState !== 'idle' ){
                    return;
                }
                conversationsState = 'loading';
                $.getJSON( '{{ path('events_conversations') }}' )
                    .done(function( result ){
                        conversations = result.conversations || [];
                        conversationsState = 'loaded';
                    })
                    .fail(function( xhr , textStatus ){
                        conversationsState = 'error';
                        conversationsError = ( xhr.responseJSON && xhr.responseJSON.message ) ? xhr.responseJSON.message : ( xhr.status + ' ' + textStatus );
                    })
                    .always(function(){
                        updateConversationInfo();
                        if( !conversationPanel.prop('hidden') ){
                            renderConversationList();
                        }
                    });
            }

            conversationToggle.on('click' , function(){
                conversationPanel.prop('hidden') ? openConversationPanel() : closeConversationPanel();
            });

            conversationFilter.on('input' , renderConversationList ).on('keydown' , function( event ){
                if( event.key === 'Enter' ){
                    // Formular nicht absenden, sondern den ersten Treffer übernehmen
                    event.preventDefault();
                    conversationList.find('.conversation-option').first().trigger('click');
                } else if( event.key === 'Escape' ){
                    closeConversationPanel();
                    conversationToggle.trigger('focus');
                }
            });

            conversationList.on('click' , '.conversation-option' , function(){
                conversationId.val( $(this).attr('data-id') );
                closeConversationPanel();
                updateConversationInfo();
            });

            $(window).on('resize scroll' , closeConversationPanel );
            $('.layout-complete').on('scroll' , closeConversationPanel );

            $(document).on('click' , function( event ){
                if( $(event.target).closest('.conversation-picker').length === 0 ){
                    closeConversationPanel();
                }
            });

            conversationId.on('input' , updateConversationInfo );

            $('.channel').change(function(){
                let self = $(this);
                let isConversation = self.val() === conversation_channel_placeholder_name;
                self.parents('tr').find('.conversation-id, .conversation-toggle').prop('disabled' , !isConversation );
                if( isConversation ){
                    loadConversations();
                } else {
                    // Bei einem Channel als Ziel gibt es keine Unterhaltung – alte ID nicht stehen lassen
                    conversationId.val('');
                    closeConversationPanel();
                }
                updateConversationInfo();
            }).change();
        } );
    </script>
{% endblock %}

{% block body %}
        <form method="post" id="action" action="{{ path('save_event') }}">
            <input type="hidden" name="id" id="actionButtonId" value="{{ current_entry.getId() ?? '' }}">
            <input type="hidden" name="_token" value="{{ csrf_token('events') }}">
            <p class="text-center">Verfügbare Platzhalter: {{ replacementKeys|join(', ') }}</p>

            <div class="layout-complete">
            <table class="object-center events-table">
                <thead>
                <tr>
                    <th>Aktionen</th>
                    <th colspan="2">Startdatum</th>
                    <th colspan="2">Enddatum</th>
                    <th>Interval</th>
                    <th>Ziel</th>
                    <th>Text</th>
                    <th>zuletzt Versendet</th>
                    <th>nächste Übermittlung</th>
                    <th>Anzahl Übermittlungen</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td class="text-center">
                        {% if current_entry.getId() is null %}
                            <button type="submit" name="action" value="add">Hinzufügen</button>
                            <input type="hidden" name="resetDue" value="1">
                        {% else %}
                            <button type="submit" name="action" value="save">Speichern</button>
                            <button type="submit" name="action" value="">Abbrechen</button>
                            <div style="font-size: 0.6rem">
                                <label for="resetDue">Übermittlung zurücksetzen</label><input type="checkbox" id="resetDue" name="resetDue" value="1">
                            </div>
                        {% endif %}
                    </td>
                    <td><input type="text" name="date" class="thw-datepicker" value="{{ current_entry.getStartDateTime()|date(date_format) }}"></td>
                    <td><input type="text" name="time" class="thw-timepicker" value="{{ current_entry.getStartDateTime()|date(time_format) }}"></td>
                    <td><input type="text" name="untilDate" id="untilDate" class="thw-datepicker" value="{{ current_entry.getUntilDateTime()|date(date_format) }}"></td>
                    <td><input type="text" name="untilTime" id="untilTime" class="thw-timepicker" value="{{ current_entry.getUntilDateTime()|date(time_format) }}"></td>
                    <td>
                        <select name="interval" id="interval">
                            <option value="">-/-</option>
                            {% for interval, label in allowed_intervals  %}
                                <option value="{{ interval }}" {{ interval == current_entry.getDateInterval() ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td class="text-center">
                        <div>
                            <select name="channel" class="channel">
                                {% for channelName in allowed_channels  %}
                                    <option value="{{ channelName }}" {{ channelName == current_entry.getChannelTarget() ? 'selected' : '' }}>{{ channelName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="conversation-picker">
                            <button type="button" class="conversation-toggle">Unterhaltung wählen …</button>
                            <div class="conversation-panel" hidden>
                                <input type="search" class="conversation-filter" placeholder="Nach Namen filtern …" autocomplete="off">
                                <ul class="conversation-list"></ul>
                            </div>
                        </div>
                        <div>
                            <input type="text" class="conversation-id" name="channel_payload_conversation_id" placeholder="ID der Konversation" value="{{ current_entry.getConversationIdFromPayload() }}">
                        </div>
                        <div class="conversation-info"></div>
                    </td>
                    <td>
                        <textarea name="text" class="thw-textarea">{{ current_entry.text ?? '' }}</textarea>
                    </td>
                    <td colspan="3"></td>
                </tr>
                {% for event in events  %}
                    <tr class="{{ event.eventFailed() ? 'event-failed' : (event.eventDone() ? 'event-done' : 'event') }}">
                        <td>
                            <div>
                                <button type="submit" class="action-button" name="action" value="edit" data-id="{{ event.getId() ?? '' }}">Editieren</button>
                                <button type="submit" class="action-button" name="action" value="delete" data-id="{{ event.getId() ?? '' }}">Löschen</button>
                            </div>
                            <div class="text-center" style="padding: 1rem;">
                                <button type="submit" class="action-button" name="action" value="trigger" data-id="{{ event.getId() ?? '' }}">Manuell senden</button>
                            </div>
                        </td>
                        <td colspan="2" class="text-center">{{ event.getStartDateTime()|date(date_time_format) }}</td>
                        <td colspan="2" class="text-center">{{ event.getUntilDateTime()|date(date_time_format) }}</td>
                        <td>{{ allowed_intervals[ event.getDateInterval() ] ?? "" }}</td>
                        <td>
                            <div>{{ event.getChannelTarget() }}</div>
                            {% if event.getConversationIdFromPayload() is not null %}
                                <div style="font-size: 0.7em;">ID der Konversation: <span style="font-style: italic;">{{ event.getConversationIdFromPayload() }}</span></div>
                            {% endif %}
                        </td>
                        <td><pre>{{ event.getText() }}</pre></td>
                        <td>{{ event.getDoneDateTime()|date(date_time_format) }}</td>
                        <td>{{ event.getDueDateTime()|date(date_time_format) }}</td>
                        <td>
                            <div>{{ event.getTransmissionsCount() }}</div>
                            {% if event.eventFailed() %}
                                <div style="font-size: 0.7em;">Fehlgeschlagen – zum erneuten Versuch Event speichern</div>
                            {% elseif event.getFailedAttempts() > 0 %}
                                <div style="font-size: 0.7em;">Fehlversuche: {{ event.getFailedAttempts() }}</div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </form>

{% endblock %}