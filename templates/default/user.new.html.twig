{% extends 'base.loggedin.html.twig' %}

{% block body %}
    <div class="wrapper layout-compact">
        <div class="form-page">
            <div class="report-header">
                <h2>Neuer Nutzer</h2>
                <span class="report-subtitle">Zugang zur Oberfläche oder für REST-Aufrufe</span>
            </div>
            <form method="post" action="{{ path('users_create') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('users') }}">
                <fieldset class="form-section">
                    <legend>Konto</legend>
                    <p class="form-hint">Administratoren melden sich an der Oberfläche an. API-Nutzer sind technische Zugänge für REST-Aufrufe (z. B. vom StAN-Manager): Nutzername und Schlüssel stehen beim Aufrufer, der Schlüssel wird beim Anlegen erzeugt und nur einmal angezeigt.</p>
                    <div class="form-grid">
                        <div class="form-field span-2">
                            <label for="user-name">Nutzername</label>
                            <input type="text" class="field" id="user-name" name="username" value="{{ form.username }}" maxlength="180" autocomplete="off" required>
                        </div>
                        <div class="form-field span-2">
                            <label for="user-kind">Art</label>
                            <select class="field" id="user-kind" name="kind">
                                {% for value, label in kinds %}<option value="{{ value }}"{{ value == form.kind ? ' selected' }}>{{ label }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="form-field span-2">
                            <label for="user-password">Passwort <small>(nur Administratoren, mindestens {{ passwordMinLength }} Zeichen)</small></label>
                            <input type="password" class="field" id="user-password" name="password" autocomplete="new-password">
                        </div>
                    </div>
                </fieldset>
                <div class="action-bar">
                    <a href="{{ path('users') }}" class="button-secondary">Abbrechen</a>
                    <button type="submit" class="button-primary">Anlegen</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
