{% extends 'base.loggedin.html.twig' %}
{# Aufbau wie „Hintergrundaufgaben“ im StAN-Manager (templates/admin/jobs.html.twig) #}
{% macro duration( ms ) %}{{ ms < 1000 ? ms ~ ' ms' : ( ms / 1000 )|number_format( 1 , ',' , '.' ) ~ ' s' }}{% endmacro %}

{% block body %}
    <div class="wrapper layout-compact">
        <div class="form-page">
            <div class="report-header">
                <h2>Hintergrundaufgaben</h2>
                <span class="report-subtitle">Was der Bot ohne Zutun erledigt</span>
            </div>
            <p class="form-hint">
                Der Server ruft jede Minute den Takt auf (Cron „daemon:tick“). Bei jedem Takt laufen die eingeschalteten Aufgaben, deren eigener Takt fällig ist.
                Das Senden geplanter Events läuft immer mit jedem Takt.
                „Jetzt ausführen“ startet eine Aufgabe sofort, auch wenn sie aus ist, und nimmt die gespeicherten Werte.
            </p>
            <p class="{{ tickLate ? 'form-hint job-tick-late' : 'form-hint job-tick' }}">
                <strong>Takt zuletzt:</strong>
                {{ lastTick ? lastTick|date('d.m.Y H:i:s')|no_break : 'noch nie' }}
                {% if tickLate %} – der Cron scheint nicht zu laufen; ohne ihn läuft keine Aufgabe von selbst.{% endif %}
            </p>

            {% for row in jobs %}
                {% set job = row.job %}
                {% set state = row.state %}
                <form method="post" action="{{ path('jobs_configure', { name: job.getName() }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('job-' ~ job.getName()) }}">
                    <fieldset class="form-section">
                        <legend>{{ job.getLabel() }}</legend>
                        <p class="form-hint">{{ job.getDescription() }}</p>
                        <p class="text-small">
                            {% if not row.enabled %}
                                <strong>Aus</strong> – läuft nicht von selbst.<br>
                            {% elseif row.nextRunAt %}
                                <strong>Nächster Lauf:</strong> ab&nbsp;{{ row.nextRunAt|date('d.m.Y H:i')|no_break }}<br>
                            {% endif %}
                            <strong>Plan:</strong> {{ row.plan }}<br>
                            <strong>Zuletzt:</strong>
                            {% if state and state.getLastStartedAt() %}
                                {{ state.getLastStartedAt()|date('d.m.Y H:i:s')|no_break }}{% if state.getLastStatus() %} – {{ statusLabels[ state.getLastStatus() ] }}{% if state.getLastMessage() %}: {{ state.getLastMessage() }}{% endif %}{% if state.getLastDurationMs() is not null %} ({{ _self.duration( state.getLastDurationMs() ) }}){% endif %}{% elseif row.running %} – läuft{% else %} – abgebrochen{% endif %}
                            {% else %}
                                noch nie
                            {% endif %}
                        </p>
                        <div class="form-grid">
                            <div class="form-field">
                                <label>&nbsp;</label>
                                <label><input type="checkbox" name="enabled" value="1"{% if row.enabled %} checked{% endif %}> eingeschaltet</label>
                            </div>
                            <div class="form-field">
                                <label for="job-interval-{{ job.getName() }}">Takt <small>(Minuten, Standard {{ job.getDefaultIntervalMinutes() }})</small></label>
                                <input type="number" class="field" id="job-interval-{{ job.getName() }}" name="interval" value="{{ row.interval }}" min="{{ minInterval }}" max="{{ maxInterval }}" required>
                            </div>
                            {% if row.setting %}
                                <div class="form-field">
                                    <label for="job-setting-{{ job.getName() }}">{{ row.setting.label }} <small>(Standard {{ row.setting.default }})</small></label>
                                    <input type="number" class="field" id="job-setting-{{ job.getName() }}" name="setting" value="{{ row.settingValue }}" min="{{ row.setting.min }}" max="{{ row.setting.max }}" required>
                                </div>
                            {% endif %}
                            <div class="form-field form-field-action span-2{{ row.setting ? ' job-actions-row' : '' }}">
                                <label>&nbsp;</label>
                                <div class="job-actions">
                                    <input type="submit" class="button-primary" value="Speichern">
                                    <button type="submit" class="button-secondary" formaction="{{ path('jobs_run', { name: job.getName() }) }}" formnovalidate data-confirm="„{{ job.getLabel() }}“ jetzt ausführen?">Jetzt ausführen</button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </form>
            {% endfor %}
        </div>
    </div>
{% endblock %}
