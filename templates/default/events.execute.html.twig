{% extends 'base.loggedin.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <form method="post" action="{{ path('execute_events_run') }}" class="text-center">
        <input type="hidden" name="_token" value="{{ csrf_token('execute_events') }}">
        <p>Verarbeitet alle fälligen geplanten Nachrichten sofort – wie der regelmäßige automatische Durchlauf.</p>
        <button type="submit">Event-Ausführer jetzt starten</button>
    </form>
    {% if response is not null %}
        <pre>{{ response }}</pre>
    {% endif %}
{% endblock %}