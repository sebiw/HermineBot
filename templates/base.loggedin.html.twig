{% extends 'base.html.twig' %}

{% block nav %}
    {# Aufbau wie templates/_navigation.html.twig im StAN-Manager: Bereich mit Unterpunkten = Link mit data-nav-toggle und
       direkt dahinter seine nav.secondary; am Rechner erscheinen nur die Unterpunkte des aktuellen Bereichs, am Handy klappen sie auf #}
    {% set route = app.current_route %}
    {% set eventsActive = route in [ 'events' , 'execute_events' , 'execute_events_run' ] %}
    {% set usersActive = route starts with 'user' %}
    <a href="{{ path('events') }}" class="{{ eventsActive ? 'active' }}" data-nav-toggle="nav-group-events">Events</a>
    <nav class="secondary{{ eventsActive ? ' is-current is-open' }}" id="nav-group-events">
        <a href="{{ path('events') }}" class="{{ route == 'events' ? 'active' }}">Übersicht</a>
        <a href="{{ path('execute_events') }}" class="{{ route starts with 'execute_events' ? 'active' }}">Event-Ausführer starten</a>
    </nav>
    <a href="{{ path('events_log') }}" class="{{ route == 'events_log' ? 'active' }}">Logs</a>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('users') }}" class="{{ usersActive ? 'active' }}" data-nav-toggle="nav-group-users">Nutzer</a>
        <nav class="secondary{{ usersActive ? ' is-current is-open' }}" id="nav-group-users">
            <a href="{{ path('users') }}" class="{{ route in [ 'users' , 'user_edit' , 'user_save' ] ? 'active' }}">Übersicht</a>
            <a href="{{ path('users_new') }}" class="{{ route in [ 'users_new' , 'users_create' ] ? 'active' }}">Neuer Nutzer</a>
        </nav>
        <a href="{{ path('jobs') }}" class="{{ route starts with 'jobs' ? 'active' }}">Hintergrundaufgaben</a>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block topnav %}
    {% if app.user %}
        <span class="login-hint no-print">Eingeloggt als {{ app.user.username }}, <a href="{{ logout_path() }}">Ausloggen</a></span>
    {% endif %}
{% endblock %}
