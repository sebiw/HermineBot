{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block nav %}
    <a href="{{ path('events') }}" class="{{ app.current_route == 'events' ? 'active' }}">Events Admin</a>
    <a href="{{ path('execute_events') }}" class="{{ app.current_route == 'execute_events' ? 'active' }}">Starte Event-Ausführer manuell</a>
    <a href="{{ path('events_log') }}" class="{{ app.current_route == 'events_log' ? 'active' }}">Logs</a>
    {{ parent() }}
{% endblock %}

{% block body %}
    {{ parent() }}
{% endblock %}

{% block topnav %}
    {% if app.user %}
        <span class="login-hint no-print">Eingeloggt als {{ app.user.username }}, <a href="{{ logout_path() }}">Ausloggen</a></span>
    {% endif %}
{% endblock %}
